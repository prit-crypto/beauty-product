# Which AI mode the assistant uses: rule | gemini | openai
# rule = static and rule-based, no key needed. Any AI failure falls back to rule automatically.
AI_PROVIDER=rule

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# backups tried when the main model is busy (503) or rate-limited (429)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite
# low = ~3x faster replies with the same accuracy (benchmarked)
GEMINI_THINKING=low

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Any OpenAI-compatible endpoint works
OPENAI_BASE_URL=https://api.openai.com/v1

AI_TIMEOUT_SECONDS=12
# true = AI also re-words replies (more natural, slower). false = AI only understands messages (faster)
AI_REWRITE=true
ADMIN_PASSWORD=change-me
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
